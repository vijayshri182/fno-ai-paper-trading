# F&O AI Paper Trading System — configuration template
#
# Copy this file to `.env` and adjust values for your paper session.
# `.env` is git-ignored: never commit real values here.
# Every variable is optional — defaults are shown as the values to the right of "#".

# Run environment: development | test | paper   (all are paper-only)
FNO_ENVIRONMENT=development

# Starting paper capital (rupees)
FNO_PAPER_INITIAL_CAPITAL=100000

# Maximum total position quantity (lots) in a single instrument
FNO_PAPER_MAX_POSITION_QUANTITY=75

# Maximum order notional (quantity * price * multiplier) in rupees
FNO_PAPER_MAX_ORDER_NOTIONAL=250000

# Maximum acceptable daily realized loss in rupees (risk manager rejects further orders beyond this)
FNO_PAPER_MAX_DAILY_LOSS=10000

# Commission charged per fill: commission_rate * notional + commission_fixed
FNO_PAPER_COMMISSION_RATE=0.0003
FNO_PAPER_COMMISSION_FIXED=0

# Slippage applied to simulated fill price as a fraction (0.001 = 0.1%)
FNO_PAPER_SLIPPAGE_RATE=0.001

# Logging level: DEBUG | INFO | WARNING | ERROR
FNO_LOG_LEVEL=INFO