# F&O AI Paper Trading System — configuration template
#
# Copy this file to `.env` and adjust values for your paper session.
# `.env` is git-ignored: never commit real values here.
# Every variable is optional — defaults are shown as the values to the right of "#".

# Run environment: development | test | paper   (all are paper-only)
FNO_ENVIRONMENT=development

# Starting paper capital (rupees)
FNO_PAPER_INITIAL_CAPITAL=100000

# Maximum total position quantity (lots) in a single instrument
FNO_PAPER_MAX_POSITION_QUANTITY=75

# Maximum order notional (quantity * price * multiplier) in rupees
FNO_PAPER_MAX_ORDER_NOTIONAL=250000

# Maximum acceptable daily realized loss in rupees (risk manager rejects further orders beyond this)
FNO_PAPER_MAX_DAILY_LOSS=10000

# Commission charged per fill: commission_rate * notional + commission_fixed
FNO_PAPER_COMMISSION_RATE=0.0003
FNO_PAPER_COMMISSION_FIXED=0

# Slippage applied to simulated fill price as a fraction (0.001 = 0.1%)
FNO_PAPER_SLIPPAGE_RATE=0.001

# Logging level: DEBUG | INFO | WARNING | ERROR
FNO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Kite Connect (read-only market data, optional)
# ---------------------------------------------------------------------------
# Copy your real credentials into `.env` — never commit them. If these are
# empty, the application and test suite still run fully on the in-memory
# provider; the Kite provider only activates when both values are present.
FNO_KITE_API_KEY=
FNO_KITE_ACCESS_TOKEN=
FNO_KITE_BASE_URL=https://api.kite.trade
FNO_KITE_TIMEOUT_SECONDS=10
FNO_KITE_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Upstox (read-only historical market data, optional) —— analytics/data layer
# ---------------------------------------------------------------------------
# The Upstox data adapter is historical-data READ-ONLY: it fetches OHLCV candles
# and never places orders. Only the access token is required for API calls; the
# client id/secret belong to the SSO token-generation flow and are optional.
# Leave empty to run fully offline on the in-memory provider.
# `scripts/acquire_dataset.py` reads this token to fetch and store real
# historical datasets under `datasets/`.
# NOTE: this is the ANALYTICS/DATA credential. The WS 7.9 execution token uses
# the separate `UPSTOX_ACCESS_TOKEN` name below and is never consumed by the
# data layer (and vice versa — the execution path never reads FNO_UPSTOX_*).
FNO_UPSTOX_CLIENT_ID=
FNO_UPSTOX_CLIENT_SECRET=
FNO_UPSTOX_ACCESS_TOKEN=
FNO_UPSTOX_API_KEY=
FNO_UPSTOX_BASE_URL=https://api.upstox.com
FNO_UPSTOX_TIMEOUT_SECONDS=10
FNO_UPSTOX_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Controlled live F&O execution integration test (WS 7.9) — OFF by default
# ---------------------------------------------------------------------------
# The execution layer never sends a real order unless ALL of the following are
# true in the same run: FNO_LIVE_EXECUTION_TEST_ENABLED=1, an operator-authored
# consent file whose whole-body sha256 fingerprint matches the sha256 of
# UPSTOX_ACCESS_TOKEN (inside its expiry window and the expiry_hours cap), and
# an explicit `--confirm-live-enablement` flag on the CLI. Keep everything off
# and empty below unless you are deliberately running the controlled live test.
FNO_LIVE_EXECUTION_TEST_ENABLED=0
FNO_LIVE_TEST_CONSENT_FILE=reports/execution/operator_consent.json
FNO_LIVE_TEST_HOLD_SECONDS=300
FNO_LIVE_TEST_EXPIRY_HOURS=24
FNO_LIVE_TEST_DRY_RUN=1
FNO_LIVE_TEST_MAX_MARGIN=100000
FNO_LIVE_TEST_ORDER_TIMEOUT_SECONDS=30
FNO_LIVE_TEST_POLL_SECONDS=2
# Execution-layer auth token (ONLY consumed by the execution adapter/gate).
# It is NOT an enablement switch: FNO_LIVE_EXECUTION_TEST_ENABLED=1 + a valid
# matching consent file are additionally required for a real send. Leave empty.
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_KEY=