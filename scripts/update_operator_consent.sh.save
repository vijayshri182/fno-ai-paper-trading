q!
#!/usr/bin/env bash
set -euo pipefail

PROJECT="/c/Vijay_GitHub/fno-ai-paper-trading"
CONSENT_FILE="$PROJECT/reports/execution/operator_consent.json"

if [[ ! -f "$CONSENT_FILE" ]]; then
echo "ERROR: Consent file not found:"
echo "$CONSENT_FILE"
exit 1
fi

if ! command -v python >/dev/null 2>&1; then
echo "ERROR: Python is not available in PATH."
exit 1
fi

read -r -s -p "Upstox access token: " UPSTOX_TOKEN
echo

if [[ -z "$UPSTOX_TOKEN" ]]; then
echo "ERROR: Token cannot be empty."
unset UPSTOX_TOKEN
exit 1
fi

export CONSENT_FILE
export UPSTOX_TOKEN

python - <<'PY'
import hashlib
import json
import os
from pathlib import Path

consent_file = Path(os.environ["CONSENT_FILE"])
token = os.environ["UPSTOX_TOKEN"]

required_fields = [
"operator",
"purpose",
"created_at",
"expires_at",
"token_fingerprint_sha256",
]

with consent_file.open("r", encoding="utf-8") as f:
consent = json.load(f)

missing = [field for field in required_fields if field not in consent]
if missing:
raise SystemExit(
"ERROR: Missing required consent field(s): "
+ ", ".join(missing)
)

fingerprint = hashlib.sha256(
token.encode("utf-8")
).hexdigest()

consent["token_fingerprint_sha256"] = fingerprint

with consent_file.open("w", encoding="utf-8") as f:
json.dump(consent, f, indent=2)
f.write("\n")

print("Consent token fingerprint updated successfully.")
print(f"File: {consent_file}")
print("Updated field: token_fingerprint_sha256")
print("Token and fingerprint were not printed.")
print("Live enablement was NOT changed.")
print("No order was placed.")
PY

unset UPSTOX_TOKEN
unset CONSENT_FILE

